# Yandex Cloud — обязательные
YANDEX_API_KEY=AQVN...          # Сервисный API-ключ (предпочтительно)
YANDEX_FOLDER_ID=b1g...         # ID каталога Yandex Cloud

# Yandex Cloud — альтернатива API-ключу (IAM-токен, протухает через 12 ч)
# YANDEX_IAM_TOKEN=t1.9euelZ...

# YandexGPT модель (опционально, по умолчанию yandexgpt-lite)
# YANDEXGPT_MODEL_URI=gpt://<folder_id>/yandexgpt/latest

# SpeechKit — голос и скорость TTS
SPEECHKIT_TTS_VOICE=filipp       # filipp | jane | omazh | zahar | ermil
SPEECHKIT_TTS_SPEED=0.9          # 0.1 – 3.0
SPEECHKIT_STT_LANG=ru-RU

# Voximplant — опциональный секрет для проверки подписи webhook
# VOXIMPLANT_WEBHOOK_SECRET=mysecret

# Приложение
APP_ENV=production
AUDIO_STORE_PATH=/tmp/audio

# Публичный URL backend (без trailing slash) — подставляется в ссылки на аудио
PUBLIC_BASE_URL=https://your-container.serverless.yandexcloud.net
