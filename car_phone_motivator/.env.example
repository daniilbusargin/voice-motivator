# =============================================================================
# Yandex Cloud — обязательные
# =============================================================================

# Сервисный API-ключ (рекомендуется; как получить — см. README)
YANDEX_API_KEY=AQVN...

# ID каталога (папки) в Yandex Cloud
YANDEX_FOLDER_ID=b1g...

# Альтернатива API-ключу: IAM-токен (протухает через 12 ч — не для прода)
# YANDEX_IAM_TOKEN=t1.9euelZ...

# =============================================================================
# YandexGPT (опционально — по умолчанию yandexgpt-lite)
# =============================================================================

# YANDEXGPT_MODEL_URI=gpt://<YANDEX_FOLDER_ID>/yandexgpt/latest

# =============================================================================
# Yandex SpeechKit (опционально — переопределяют дефолты)
# =============================================================================

SPEECHKIT_TTS_VOICE=filipp      # filipp | jane | omazh | zahar | ermil | alena
SPEECHKIT_TTS_SPEED=0.9         # 0.1 – 3.0
SPEECHKIT_STT_LANG=ru-RU

# =============================================================================
# Voximplant (опционально)
# =============================================================================

# Секрет для HMAC-верификации входящих webhook (задаётся в Voximplant → HTTP API)
# VOXIMPLANT_WEBHOOK_SECRET=mysecret

# =============================================================================
# Приложение
# =============================================================================

APP_ENV=production
AUDIO_STORE_PATH=/tmp/audio
MAX_RECORD_SECONDS=10
SILENCE_TIMEOUT_SECONDS=2

# Публичный URL backend (без trailing slash).
# Voximplant скачивает аудиофайлы ответов по этому адресу.
# Локально — используй ngrok: https://xxxx.ngrok-free.app
PUBLIC_BASE_URL=https://your-container.containers.yandexcloud.net
