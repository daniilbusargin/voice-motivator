# =============================================================================
# Yandex Cloud — обязательные
# =============================================================================

# Сервисный API-ключ (рекомендуется; как получить — см. README раздел "Переменные")
YANDEX_API_KEY=AQVN...

# ID каталога (папки) в Yandex Cloud
YANDEX_FOLDER_ID=b1g...

# Альтернатива API-ключу: IAM-токен (протухает через 12 ч — не для прода)
# YANDEX_IAM_TOKEN=t1.9euelZ...

# =============================================================================
# YandexGPT (опционально)
# =============================================================================

# По умолчанию используется yandexgpt-lite. Для более умной модели:
# YANDEXGPT_MODEL_URI=gpt://<YANDEX_FOLDER_ID>/yandexgpt/latest

# =============================================================================
# Yandex SpeechKit (опционально — переопределяют дефолты)
# =============================================================================

SPEECHKIT_TTS_VOICE=filipp      # filipp | jane | omazh | zahar | ermil | alena
SPEECHKIT_TTS_SPEED=0.9         # 0.1 – 3.0
SPEECHKIT_STT_LANG=ru-RU

# =============================================================================
# МТС Exolve — телефония
# =============================================================================

# API-ключ из личного кабинета Exolve (как получить — см. README)
EXOLVE_API_KEY=...

# ID приложения Exolve (отображается в разделе "Приложения")
EXOLVE_APP_ID=...

# Базовый URL Exolve API (менять не нужно)
EXOLVE_API_URL=https://api.exolve.ru

# Опциональный секрет для верификации входящих webhook (задаётся в Exolve)
# EXOLVE_WEBHOOK_SECRET=mysecret

# =============================================================================
# Приложение
# =============================================================================

APP_ENV=production

# Путь для хранения временных аудиофайлов
AUDIO_STORE_PATH=/tmp/audio

# Максимальная длина записи реплики водителя (секунды)
MAX_RECORD_SECONDS=10

# Пауза тишины, после которой запись считается завершённой (секунды)
SILENCE_TIMEOUT_SECONDS=2

# Публичный URL backend (без trailing slash).
# Используется в ссылках на аудиофайлы, которые отдаются Exolve.
# Для локального теста через ngrok: https://xxxx.ngrok.io
PUBLIC_BASE_URL=https://your-container.containers.yandexcloud.net
